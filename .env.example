# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend server settings (Dokploy / production)
PORT=3000
DATA_DIR="data"
# Comma-separated frontend origins allowed for CORS & WebSockets (e.g. GitHub Pages URL)
ALLOWED_ORIGINS="https://your-username.github.io"

# Proxy / geolocalización
# Nº de proxies de confianza delante del proceso (Dokploy/Traefik = 1, directo = 0).
# Con 0 se ignora X-Forwarded-For y se usa la IP del socket.
TRUST_PROXY_HOPS=1
# Aceptar cabeceras CF-* (CF-IPCity, CF-IPCountry...). Solo si Cloudflare está delante.
TRUST_CF_HEADERS=0

# Límites de presencia y WebSocket (opcionales, estos son los valores por defecto)
MAX_WS_CONNECTIONS=5000
MAX_WS_PER_IP=16
WS_ATTEMPTS_PER_MINUTE=40
MAX_PRESENCE_CITIES=500
HTTP_API_LIMIT_PER_MINUTE=120
HTTP_AUDIO_LIMIT_PER_MINUTE=300

# Frontend build-time settings (GitHub Pages)
# Leave empty for same-origin hosting; set to your Dokploy backend URL when hosted separately
VITE_API_BASE_URL=""
# Set to "/your-repo-name/" when deploying to a GitHub Pages project subpath
VITE_BASE_PATH="/"
