# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend server settings (Dokploy / production)
PORT=3000
DATA_DIR="data"
# Comma-separated frontend origins allowed for CORS & WebSockets (e.g. GitHub Pages URL)
ALLOWED_ORIGINS="https://your-username.github.io"

# Frontend build-time settings (GitHub Pages)
# Leave empty for same-origin hosting; set to your Dokploy backend URL when hosted separately
VITE_API_BASE_URL=""
# Set to "/your-repo-name/" when deploying to a GitHub Pages project subpath
VITE_BASE_PATH="/"
